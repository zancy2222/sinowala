# ---------------------------------------------------------------
# SinoWala — environment settings
# Kopyahin ito bilang .env, tapos palitan ang mga value.
# HUWAG i-commit ang .env (naka-ignore na ito sa .gitignore).
# ---------------------------------------------------------------

# Pangalan ng app (lumalabas sa emails at title).
APP_NAME=SinoWala
# local habang nagde-develop, production sa live server.
APP_ENV=local
# Gumawa gamit ang: php artisan key:generate  (huwag palitan kapag live na — mabubura ang access sa encrypted notes)
APP_KEY=
# false palagi sa production.
APP_DEBUG=true
# Buong URL ng site, walang slash sa dulo. https:// sa production.
APP_URL=http://localhost:8000

# Wika at timezone ng app (fil = Taglish na copy sa lang/fil).
APP_LOCALE=fil
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

# file = gumagana sa shared hosting.
APP_MAINTENANCE_DRIVER=file

# Lakas ng password hashing (bcrypt).
BCRYPT_ROUNDS=12

# Logs: "daily" para may rotation; error lang sa production.
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# --- Database (MariaDB 10.11+) ---
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sinowala
DB_USERNAME=root
DB_PASSWORD=
# Folder ng mysqldump/mariadb-dump para sa backups (hal. C:/xampp/mysql/bin o /usr/bin). Iwanang blangko kung nasa PATH.
DB_DUMP_BINARY_PATH=

# --- Session (database driver; 120 minuto) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=sinowala_session
# true sa production (HTTPS lang ang cookie). Kapag blangko: true kung APP_ENV=production.
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Queue: database driver.
QUEUE_CONNECTION=database
# true = ang scheduler (cron) ang magpapatakbo ng queue bawat minuto (para sa shared hosting).
# false = may Supervisor kang queue worker (VPS).
QUEUE_VIA_SCHEDULER=true

CACHE_STORE=database

# --- Mail (SMTP) ---
# "log" habang local (nasa storage/logs ang emails). "smtp" sa production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- SinoWala ---
# Ang email ng Super Admin (ikaw). Kailangang verified at may 2FA bago bumukas ang /admin.
SUPER_ADMIN_EMAIL=
# Lumalabas sa legal pages at footer.
BUSINESS_NAME="[PLACEHOLDER: pangalan ng negosyo]"
BUSINESS_ADDRESS="[PLACEHOLDER: address ng negosyo]"
BUSINESS_EMAIL="[PLACEHOLDER: contact email]"
DPO_NAME="[PLACEHOLDER: pangalan ng Data Protection Officer]"
DPO_EMAIL="[PLACEHOLDER: email ng DPO]"
# Kung nasa likod ng proxy (Cloudflare, load balancer): * o comma-separated IPs. Blangko kung wala.
TRUSTED_PROXIES=

# --- Backups (spatie/laravel-backup: database araw-araw, 14 araw) ---
# Saan ipapadala ang notice kapag pumalya ang backup (default: SUPER_ADMIN_EMAIL).
BACKUP_NOTIFICATION_EMAIL=
# Opsyonal na password para sa zip ng backup.
BACKUP_ARCHIVE_PASSWORD=

# --- Analytics (opsyonal, privacy-friendly) ---
# Iwanang blangko = walang analytics. Kapag may laman, lalabas lang ito
# sa mga bisitang pumayag sa "Analytics" sa cookie settings.
# Plausible: ilagay ang domain mo (hal. sinowala.ph).
ANALYTICS_ID=
ANALYTICS_SRC=https://plausible.io/js/script.js

VITE_APP_NAME="${APP_NAME}"
